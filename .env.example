# ============================================================
# AI Phishing Playground — environment configuration
# ============================================================
# Copy this file to .env and fill in values.
# .env is gitignored — never commit API keys.

# ----------------------------------------------------------
# MiniMax API (required)
# ----------------------------------------------------------
# Get your key: https://platform.minimax.io/user-center/basic-information
MINIMAX_API_KEY=sk-your-api-key-here

# International API:  https://api.minimax.io/v1
# China Mainland:     https://api.minimaxi.com/v1
MINIMAX_API_BASE=https://api.minimax.io/v1

# OpenAI-compatible key (passed to OpenCode)
OPENAI_API_KEY=${MINIMAX_API_KEY}

# ----------------------------------------------------------
# Git identity
# ----------------------------------------------------------
GIT_USER_NAME=AI Trash Generator
GIT_USER_EMAIL=ai-trash@localhost

# ----------------------------------------------------------
# Behavior flags
# ----------------------------------------------------------
# Set to "true" to push to GitHub. "false" for local-only commits.
PUSH_ENABLED=true

# Seconds between AI iterations
AGENT_LOOP_INTERVAL=5

# Seconds to wait after a failed iteration
AGENT_RETRY_DELAY=60

# ----------------------------------------------------------
# SSH (for push mode)
# ----------------------------------------------------------
SSH_KEY_PATH=/root/.ssh/id_ed25519
